// SPDX-License-Identifier: GPL-2.0
/*
 * Samsung Galaxy Tab A 10.1 (2016) LTE (gtaxllte) device tree source
 *
 * Copyright (c) 2016 Samsung Electronics Co., Ltd.
 */

/dts-v1/;
#include "exynos7870.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Samsung Galaxy Tab A 10.1 (2016) LTE";
	compatible = "samsung,gtaxllte", "samsung,exynos7870";
	chassis-type = "tablet";

	aliases {
		mmc0 = &mmc0;
		mmc1 = &mmc1;
		mmc2 = &mmc2;
		serial0 = &serial0;
		serial1 = &serial1;
		serial2 = &serial2;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		stdout-path = &serial2;

		framebuffer@67000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x67000000 (1200 * 1920 * 4)>;
			width = <1200>;
			height = <1920>;
			stride = <(1200 * 4)>;
			format = "a8r8g8b8";
		};
	};

	gpio-hall-effect-sensor {
		compatible = "gpio-keys";
		label = "GPIO Hall Effect Sensor";

		pinctrl-0 = <&hall_irq>;
		pinctrl-names = "default";

		event-hall-effect-sensor {
			label = "Hall Effect Sensor";
			gpios = <&gpa1 3 GPIO_ACTIVE_LOW>;
			wakeup-source;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			linux,can-disable;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		label = "GPIO Keys";

		pinctrl-0 = <&key_power &key_voldown &key_volup &key_home>;
		pinctrl-names = "default";

		key-home {
			label = "Home Key";
			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
			wakeup-source;
			linux,code = <KEY_HOMEPAGE>;
		};

		key-power {
			label = "Power Key";
			gpios = <&gpa0 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
			linux,code = <KEY_POWER>;
		};

		key-voldown {
			label = "Volume Down Key";
			gpios = <&gpa2 1 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
		};

		key-volup {
			label = "Volume Up Key";
			gpios = <&gpa2 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};
	};

	sound {
		compatible = "samsung,gtaxllte-audio";
		model = "SM-T585";

		/* Combo jack insertion, as downstream sec_jack detect-gpio */
		hp-det-gpios = <&gpa0 5 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&jack_det>;
		pinctrl-names = "default";

		audio-routing = "Headphone", "HPOL",
				"Headphone", "HPOR",
				"Speaker", "SPOL",
				"Speaker", "SPOR",
				"IN3P", "Main Mic",
				"IN3N", "Main Mic",
				"Main Mic", "MICBIAS2",
				"IN1P", "Headset Mic",
				"IN1N", "Headset Mic",
				"Headset Mic", "MICBIAS1";

		cpu {
			sound-dai = <&i2s0 0>;
		};

		/* Mixer first, codec second (the driver relies on the order) */
		codec {
			sound-dai = <&audio_mixer>, <&rt5659>;
		};
	};

	/*
	 * Battery NTC on ADC channel 1. Table from the downstream gtaxllte
	 * battery DT (temp_table_adc/_data), reversed: falling ADC values,
	 * converted from raw codes to mV (the ADC scale is vdd / 4095).
	 */
	battery_ntc: thermal-sensor-battery {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0>;
		#io-channel-cells = <0>;
		io-channels = <&adc 1>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table = <
			(-20000) 1561
			(-15000) 1508
			(-10000) 1444
			(-5000) 1381
			0 1303
			5000 1223
			10000 1137
			15000 1051
			20000 965
			25000 880
			30000 798
			35000 724
			40000 649
			45000 576
			50000 517
			55000 469
			60000 413
			65000 368
			70000 328
			75000 297
			80000 255
			85000 220
			90000 189>;
	};

	thermal-zones {
		battery-thermal {
			polling-delay-passive = <0>;
			polling-delay = <5000>;
			thermal-sensors = <&battery_ntc>;

			/* The charger acts on the temperature itself */
			trips {
				battery_hot: battery-hot {
					temperature = <50000>;
					hysteresis = <5000>;
					type = "hot";
				};
			};
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x3e400000>,
		      <0x0 0x80000000 0x40000000>;
	};

	/*
	 * Both clusters run from BUCK1. The voltages are this chip's (ASV group 7,
	 * read from Lineage's mp-cpufreq volt tables); each OPP allows up to the
	 * top voltage so the two clusters' requests on the shared BUCK1 overlap
	 * and the regulator settles on the higher one.
	 */
	opp_table_cluster0: opp-table-cluster0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-342875000 {
			opp-hz = /bits/ 64 <342875000>;
			opp-microvolt = <600000 600000 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-448500000 {
			opp-hz = /bits/ 64 <448500000>;
			opp-microvolt = <606250 606250 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-546000000 {
			opp-hz = /bits/ 64 <546000000>;
			opp-microvolt = <625000 625000 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-676000000 {
			opp-hz = /bits/ 64 <676000000>;
			opp-microvolt = <668750 668750 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-756600000 {
			opp-hz = /bits/ 64 <756600000>;
			opp-microvolt = <693750 693750 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-838500000 {
			opp-hz = /bits/ 64 <838500000>;
			opp-microvolt = <712500 712500 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-902200000 {
			opp-hz = /bits/ 64 <902200000>;
			opp-microvolt = <737500 737500 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1014000000 {
			opp-hz = /bits/ 64 <1014000000>;
			opp-microvolt = <781250 781250 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1144000000 {
			opp-hz = /bits/ 64 <1144000000>;
			opp-microvolt = <825000 825000 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1248000000 {
			opp-hz = /bits/ 64 <1248000000>;
			opp-microvolt = <868750 868750 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1352000000 {
			opp-hz = /bits/ 64 <1352000000>;
			opp-microvolt = <906250 906250 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1482000000 {
			opp-hz = /bits/ 64 <1482000000>;
			opp-microvolt = <956250 956250 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1586000000 {
			opp-hz = /bits/ 64 <1586000000>;
			opp-microvolt = <1006250 1006250 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1690000000 {
			opp-hz = /bits/ 64 <1690000000>;
			opp-microvolt = <1068750 1068750 1068750>;
			clock-latency-ns = <200000>;
		};
	};

	opp_table_cluster1: opp-table-cluster1 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-342875000 {
			opp-hz = /bits/ 64 <342875000>;
			opp-microvolt = <600000 600000 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-448500000 {
			opp-hz = /bits/ 64 <448500000>;
			opp-microvolt = <606250 606250 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-546000000 {
			opp-hz = /bits/ 64 <546000000>;
			opp-microvolt = <625000 625000 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-676000000 {
			opp-hz = /bits/ 64 <676000000>;
			opp-microvolt = <668750 668750 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-756600000 {
			opp-hz = /bits/ 64 <756600000>;
			opp-microvolt = <693750 693750 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-838500000 {
			opp-hz = /bits/ 64 <838500000>;
			opp-microvolt = <712500 712500 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-902200000 {
			opp-hz = /bits/ 64 <902200000>;
			opp-microvolt = <737500 737500 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1014000000 {
			opp-hz = /bits/ 64 <1014000000>;
			opp-microvolt = <781250 781250 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1144000000 {
			opp-hz = /bits/ 64 <1144000000>;
			opp-microvolt = <825000 825000 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1248000000 {
			opp-hz = /bits/ 64 <1248000000>;
			opp-microvolt = <868750 868750 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1352000000 {
			opp-hz = /bits/ 64 <1352000000>;
			opp-microvolt = <906250 906250 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1482000000 {
			opp-hz = /bits/ 64 <1482000000>;
			opp-microvolt = <956250 956250 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1586000000 {
			opp-hz = /bits/ 64 <1586000000>;
			opp-microvolt = <1006250 1006250 1068750>;
			clock-latency-ns = <200000>;
		};

		opp-1690000000 {
			opp-hz = /bits/ 64 <1690000000>;
			opp-microvolt = <1068750 1068750 1068750>;
			clock-latency-ns = <200000>;
		};
	};

	/* WLAN_EN, mmc1 */
	pwrseq_mmc1: pwrseq-mmc1 {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpd3 6 GPIO_ACTIVE_LOW>;
	};

	/*
	 * 32.768 kHz sleep clock of the QCA9377 BT part. Presumably the PMIC
	 * 32 kHz output, which S-Boot leaves running and mainline does not
	 * model for the S2MPU05; the binding requires a clock phandle.
	 */
	bt_sleep_clk: clock-bt-sleep {
		compatible = "fixed-clock";
		clock-frequency = <32768>;
		#clock-cells = <0>;
	};

	/* WLAN and BT DCDC enable, mmc1: vmmc */
	vdd_fixed_wlan: regulator-fixed-wlan {
		compatible = "regulator-fixed";
		regulator-name = "cnss_dcdc_en";
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		gpio = <&gpa0 6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <4000>;
		/*
		 * Shared by WiFi and BT: mmc1 power cycles (ath10k hif power
		 * down/up) must not cut BT, and the WiFi chip fails to come
		 * back (-ETIME) when the DCDC drops. Downstream keeps it on too.
		 */
		regulator-always-on;
	};

	/* mmc2: vmmc */
	vdd_fixed_mmc2: regulator-fixed-mmc2 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_fixed_mmc2";
		regulator-max-microvolt = <2800000>;
		regulator-min-microvolt = <2800000>;
		gpio = <&gpc0 0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/* touchscreen: avdd */
	vdd_fixed_tsp_a: regulator-fixed-tsp-a {
		compatible = "regulator-fixed";
		regulator-name = "vdd_fixed_tsp_a";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpd1 6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/* touchscreen: vdd */
	vdd_fixed_tsp_d: regulator-fixed-tsp-d {
		compatible = "regulator-fixed";
		regulator-name = "vdd_fixed_tsp_d";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&gpd1 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * panel: vdd, external buck. Always on: it keeps the bootloader
	 * framebuffer visible until the panel driver (a module) takes over.
	 */
	vdd_fixed_lcd: regulator-fixed-lcd {
		compatible = "regulator-fixed";
		regulator-name = "vdd_fixed_lcd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpd3 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	reserved-memory {
		ranges;
		#address-cells = <2>;
		#size-cells = <1>;

		/* Same location as j6lte; not yet verified on this board. */
		ramoops@46e00000 {
			compatible = "ramoops";
			reg = <0x0 0x46e00000 0x8000>;
			console-size = <0x4000>;
			pmsg-size = <0x4000>;
		};

		cont_splash_mem: framebuffer@67000000 {
			reg = <0x0 0x67000000 (1200 * 1920 * 4)>;
			iommu-addresses = <&decon 0x67000000 (1200 * 1920 * 4)>;
			no-map;
		};
	};
};

&audio_mixer {
	pinctrl-0 = <&i2s_extcodec_bus>;
	pinctrl-names = "default";

	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_buck1>;
	operating-points-v2 = <&opp_table_cluster0>;
};

&cpu1 {
	cpu-supply = <&vdd_buck1>;
	operating-points-v2 = <&opp_table_cluster0>;
};

&cpu2 {
	cpu-supply = <&vdd_buck1>;
	operating-points-v2 = <&opp_table_cluster0>;
};

&cpu3 {
	cpu-supply = <&vdd_buck1>;
	operating-points-v2 = <&opp_table_cluster0>;
};

&cpu4 {
	cpu-supply = <&vdd_buck1>;
	operating-points-v2 = <&opp_table_cluster1>;
};

&cpu5 {
	cpu-supply = <&vdd_buck1>;
	operating-points-v2 = <&opp_table_cluster1>;
};

&cpu6 {
	cpu-supply = <&vdd_buck1>;
	operating-points-v2 = <&opp_table_cluster1>;
};

&cpu7 {
	cpu-supply = <&vdd_buck1>;
	operating-points-v2 = <&opp_table_cluster1>;
};

/*
 * Cooling states index the OPP tables from the top: state 4 = 1248 MHz,
 * state 11 = 546 MHz, the downstream clip levels at 81 and 91 C.
 */
&soc_thermal {
	cooling-maps {
		map0 {
			trip = <&soc_alert0>;
			cooling-device = <&cpu0 0 4>, <&cpu4 0 4>;
		};

		map1 {
			trip = <&soc_alert1>;
			cooling-device = <&cpu0 4 11>, <&cpu4 4 11>;
		};
	};
};

&decon {
	memory-region = <&cont_splash_mem>;

	status = "okay";
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;

	samsung,burst-clock-frequency = <980000000>;
	samsung,esc-clock-frequency = <16000000>;
	samsung,pll-clock-frequency = <26000000>;

	status = "okay";

	panel@0 {
		compatible = "samsung,gtaxllte-boe-hx8279d";
		reg = <0>;
		reset-gpios = <&gpd4 1 GPIO_ACTIVE_LOW>;
		iovcc-supply = <&vdd_ldo35>;
		vdd-supply = <&vdd_fixed_lcd>;
	};
};

&gpu {
	status = "okay";
};

&hsi2c0 {
	#address-cells = <1>;
	#size-cells = <0>;

	status = "okay";

	pmic@66 {
		compatible = "samsung,s2mpu05-pmic";
		reg = <0x66>;
		interrupt-parent = <&gpa0>;
		interrupts = <2 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-0 = <&pmic_irq>;
		pinctrl-names = "default";

		regulators {
			vdd_buck1: buck1 {
				regulator-name = "vdd_buck1";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_buck2: buck2 {
				regulator-name = "vdd_buck2";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_buck3: buck3 {
				regulator-name = "vdd_buck3";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_buck4: buck4 {
				regulator-name = "vdd_buck4";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1500000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_buck5: buck5 {
				regulator-name = "vdd_buck5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <2100000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo1: ldo1 {
				regulator-name = "vdd_ldo1";
				regulator-min-microvolt = <650000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* mmc2: vqmmc */
			vdd_ldo2: ldo2 {
				regulator-name = "vdd_ldo2";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <2800000>;
				regulator-ramp-delay = <12000>;
			};

			vdd_ldo3: ldo3 {
				regulator-name = "vdd_ldo3";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2375000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo4: ldo4 {
				regulator-name = "vdd_ldo4";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo5: ldo5 {
				regulator-name = "vdd_ldo5";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo6: ldo6 {
				regulator-name = "vdd_ldo6";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo7: ldo7 {
				regulator-name = "vdd_ldo7";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2375000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* usbdrd: vdd33 */
			vdd_ldo8: ldo8 {
				regulator-name = "vdd_ldo8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
			};

			vdd_ldo9: ldo9 {
				regulator-name = "vdd_ldo9";
				regulator-min-microvolt = <650000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo10: ldo10 {
				regulator-name = "vdd_ldo10";
				regulator-min-microvolt = <650000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* codec: 1.8V */
			vdd_ldo25: ldo25 {
				regulator-name = "vdd_ldo25";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			/* mmc0: vmmc */
			vdd_ldo26: ldo26 {
				regulator-name = "vdd_ldo26";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
			};

			/* mmc0: vqmmc */
			vdd_ldo27: ldo27 {
				regulator-name = "vdd_ldo27";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2375000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
			};

			/* camera: AF 2.8V */
			vdd_ldo29: ldo29 {
				regulator-name = "vdd_ldo29";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};

			/* camera: core 1.2V */
			vdd_ldo30: ldo30 {
				regulator-name = "vdd_ldo30";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
			};

			vdd_ldo31: ldo31 {
				regulator-name = "vdd_ldo31";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* codec: 3.3V */
			vdd_ldo32: ldo32 {
				regulator-name = "vdd_ldo32";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			/*
			 * sensors: 2.8V. Always on as downstream (vdd-alwayson):
			 * the cm3323 driver takes no supply.
			 */
			vdd_ldo33: ldo33 {
				regulator-name = "vdd_ldo33";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* camera: I/O 1.8V */
			vdd_ldo34: ldo34 {
				regulator-name = "vdd_ldo34";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			/* panel: 1.8V, kept on for the bootloader framebuffer */
			vdd_ldo35: ldo35 {
				regulator-name = "vdd_ldo35";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

/* Battery NTC on channel 1, VBAT divider on channel 3 (downstream io-channels) */
&adc {
	/* Not in the downstream DT; LDO3 (1.8 V, always-on) as on other Exynos boards */
	vdd-supply = <&vdd_ldo3>;

	status = "okay";
};

&i2c0 {
	status = "okay";

	/* Alert IRQ on gpa0-3 is not used yet */
	fuel_gauge: fuel-gauge@71 {
		compatible = "siliconmitus,sm5703-fuel-gauge";
		reg = <0x71>;
		power-supplies = <&charger>;
	};
};

&i2c1 {
	samsung,i2c-sda-delay = <100>;
	samsung,i2c-max-bus-freq = <400000>;

	status = "okay";

	touchscreen@49 {
		compatible = "st,fts1a096";
		reg = <0x49>;
		interrupt-parent = <&gpa0>;
		interrupts = <4 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-0 = <&touch_irq>;
		pinctrl-names = "default";

		touchscreen-size-x = <1200>;
		touchscreen-size-y = <1920>;
		touch-key-connected;

		avdd-supply = <&vdd_fixed_tsp_a>;
		vdd-supply = <&vdd_fixed_tsp_d>;
	};
};

/*
 * SM5703 MUIC: no driver binds (EXTCON_SM5502 stays off, it would write the
 * USB switch); the charger only reads its device-type registers.
 */
&i2c2 {
	status = "okay";

	muic: extcon@25 {
		compatible = "siliconmitus,sm5703-muic";
		reg = <0x25>;
		interrupt-parent = <&gpa2>;
		interrupts = <6 IRQ_TYPE_LEVEL_LOW>;
	};
};

/* SM5703 MFD @0x49: only the charger is used (IRQ gpa2-7 polled instead) */
&i2c4 {
	status = "okay";

	charger: charger@49 {
		compatible = "siliconmitus,sm5703-charger";
		reg = <0x49>;
		enable-gpios = <&gpd1 3 GPIO_ACTIVE_LOW>;
		siliconmitus,muic = <&muic>;
		io-channels = <&battery_ntc>;
		io-channel-names = "batt-temp";
	};
};

&i2c5 {
	samsung,i2c-sda-delay = <100>;
	samsung,i2c-max-bus-freq = <400000>;

	status = "okay";

	rt5659: audio-codec@1b {
		compatible = "realtek,rt5659";
		reg = <0x1b>;
		#sound-dai-cells = <0>;

		pinctrl-0 = <&codec_gpio>;
		pinctrl-names = "default";

		/* 26 MHz from PMU CLKOUT; feeds PLL1 at 48 kHz */
		clocks = <&pmu_system_controller 0>;
		clock-names = "mclk";

		/*
		 * The driver requests "ldo1-en"/"reset", not the binding's
		 * realtek,-prefixed names. Reset is driven high (= running)
		 * and never toggled, hence ACTIVE_HIGH.
		 */
		ldo1-en-gpios = <&gpd3 2 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpd3 3 GPIO_ACTIVE_HIGH>;

		realtek,in3-differential;
		realtek,in4-differential;
	};
};

/* I2C_SENSOR1 (downstream i2c@138D0000) */
&i2c7 {
	samsung,i2c-sda-delay = <100>;
	samsung,i2c-max-bus-freq = <400000>;

	status = "okay";

	/*
	 * Downstream k2hh: axis map x,y,z = 0,1,2 and only z negated. The
	 * driver output is in the Android frame (x right, y up, z out of the
	 * screen, panel is portrait-native), the same frame the mount matrix
	 * maps to. To be verified on hardware, see docs/sensors-test-plan-2026-10-27.md.
	 */
	accelerometer@1d {
		compatible = "st,lis2hh12";
		reg = <0x1d>;
		interrupt-parent = <&gpa0>;
		interrupts = <7 IRQ_TYPE_EDGE_RISING>;

		pinctrl-0 = <&acc_int>;
		pinctrl-names = "default";

		vdd-supply = <&vdd_ldo33>;
		vddio-supply = <&vdd_ldo3>;

		mount-matrix = "1", "0", "0",
			       "0", "1", "0",
			       "0", "0", "-1";
	};

	light-sensor@10 {
		compatible = "capella,cm3323";
		reg = <0x10>;
	};
};

&i2s0 {
	status = "okay";
};

&mmc0 {
	pinctrl-0 = <&sd0_clk &sd0_cmd &sd0_rdqs &sd0_bus1 &sd0_bus4 &sd0_bus8>;
	pinctrl-names = "default";

	vmmc-supply = <&vdd_ldo26>;
	vqmmc-supply = <&vdd_ldo27>;

	bus-width = <8>;
	fifo-depth = <64>;
	non-removable;

	samsung,dw-mshc-ciu-div = <3>;
	samsung,dw-mshc-sdr-timing = <0 4>;
	samsung,dw-mshc-ddr-timing = <2 4>;

	status = "okay";
};

&mmc1 {
	pinctrl-0 = <&sd1_clk &sd1_cmd &sd1_bus1 &sd1_bus4>;
	pinctrl-names = "default";

	mmc-pwrseq = <&pwrseq_mmc1>;
	vmmc-supply = <&vdd_fixed_wlan>;

	bus-width = <4>;
	fifo-depth = <64>;
	non-removable;
	cap-sd-highspeed;
	cap-sdio-irq;

	samsung,dw-mshc-ciu-div = <3>;
	samsung,dw-mshc-sdr-timing = <0 3>;
	samsung,dw-mshc-ddr-timing = <1 2>;

	status = "okay";
};

&mmc2 {
	pinctrl-0 = <&sd2_clk &sd2_cmd &sd2_bus1 &sd2_bus4 &dwmmc2_irq>;
	pinctrl-names = "default";

	vmmc-supply = <&vdd_fixed_mmc2>;
	vqmmc-supply = <&vdd_ldo2>;

	bus-width = <4>;
	card-detect-delay = <200>;
	fifo-depth = <64>;
	samsung,dw-mshc-ciu-div = <3>;
	samsung,dw-mshc-sdr-timing = <0 3>;
	samsung,dw-mshc-ddr-timing = <1 2>;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	broken-cd;
	disable-wp;

	status = "okay";
};

&oscclk {
	clock-frequency = <26000000>;
};

&pinctrl_alive {
	acc_int: acc-int-pins {
		samsung,pins = "gpa0-7";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	dwmmc2_irq: dwmmc2-irq-pins {
		samsung,pins = "gpa0-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	hall_irq: hall-irq-pins {
		samsung,pins = "gpa1-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	jack_det: jack-det-pins {
		samsung,pins = "gpa0-5";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	key_home: key-home-pins {
		samsung,pins = "gpa1-7";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	key_power: key-power-pins {
		samsung,pins = "gpa0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	key_voldown: key-voldown-pins {
		samsung,pins = "gpa2-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	key_volup: key-volup-pins {
		samsung,pins = "gpa2-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	pmic_irq: pmic-irq-pins {
		samsung,pins = "gpa0-2";
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR4>;
	};

	touch_irq: touch-irq-pins {
		samsung,pins = "gpa0-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};
};

&pinctrl_dispaud {
	/* Mixer <-> RT5659 bus (downstream "i2s-pmic-bus-extcodec") */
	i2s_extcodec_bus: i2s-extcodec-bus-pins {
		samsung,pins = "gpz1-0", "gpz1-1", "gpz1-2", "gpz1-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR3>;
	};
};

&pinctrl_top {
	bt_en: bt-en-pins {
		samsung,pins = "gpd4-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};

	codec_gpio: codec-gpio-pins {
		samsung,pins = "gpd3-2", "gpd3-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};
};

/* CLKOUT source 31 (TCXO) is the codec MCLK, as downstream "oscclk_aud" */
&pmu_system_controller {
	clocks = <&oscclk>;
	clock-names = "clkout31";
	#clock-cells = <1>;

	assigned-clocks = <&pmu_system_controller 0>;
	assigned-clock-parents = <&oscclk>;
};

/* UART_BTWIFIFM (downstream serial_0 @13810000): QCA9377 Bluetooth HCI */
&serial1 {
	uart-has-rtscts;

	status = "okay";

	bluetooth {
		compatible = "qcom,qca9377-bt";
		clocks = <&bt_sleep_clk>;
		enable-gpios = <&gpd4 0 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&bt_en>;
		pinctrl-names = "default";
		/* cnss_dcdc_en, shared with WiFi and held on by mmc1; hci_qca does not manage it for ROME */
		vddio-supply = <&vdd_fixed_wlan>;
	};
};

&serial2 {
	status = "okay";
};

&usbdrd {
	vdd33-supply = <&vdd_ldo8>;

	status = "okay";
};
